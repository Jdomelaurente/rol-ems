generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id        Int      @id @default(autoincrement())
  reference String   @unique
  facility  String
  itemName  String
  date      String
  time      String
  nights    Int?
  hours     Int?
  guests    Int
  name      String?
  contact   String?
  email     String?
  amount    Float
  payment   String
  status    String   @default("pending")
  paymentStatus    String    @default("unpaid")
  paidMethod       String?
  paymentReference String?
  paidAt           DateTime?
  archivedAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facility, date])
  @@index([paymentStatus])
  @@index([archivedAt])
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  tokenHash String    @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PickleballState {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}
